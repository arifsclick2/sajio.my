APP_NAME="Sajio API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://api.sajio.my

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sajio
DB_USERNAME=sajio
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.sajio.my
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=mailgun
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=2525
MAIL_USERNAME=noreply@e.sajio.my
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@e.sajio.my"
MAIL_FROM_NAME="Sajio"
MAILGUN_SECRET=
MAILGUN_DOMAIN=e.sajio.my
MAILGUN_ENDPOINT=api.mailgun.net

SANCTUM_STATEFUL_DOMAINS=app.sajio.my,sajio.my,www.sajio.my
FRONTEND_URL=https://app.sajio.my
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.sajio.my,https://sajio.my,https://www.sajio.my

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

